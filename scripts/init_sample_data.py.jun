#!/usr/bin/env python3

from pathlib import Path
from pytest_oof.db import init_db, add_session, add_test_result
from datetime import datetime, timedelta
import uuid

# Initialize database
db_path = Path('oof/oof-results.db')
init_db(db_path)

# Add sample sessions and test results
suts = ['qa-ref-azulprimejdk17', 'qa-ref-dist-core-azulprime17']
for sut in suts:
    for i in range(5):  # 5 sessions per SUT
        session_id = str(uuid.uuid4())
        start_time = datetime.now() - timedelta(days=i)

        # Add session
        add_session(
            db_path=db_path,
            session_id=session_id,
            start_time=start_time,
            sut_id=sut,
            sut_type='java',
            sut_version='17',
            sut_env='prod'
        )

        # Add test results
        for j in range(10):  # 10 tests per session
            test_result = {
                'nodeid': f'test_{j}',
                'outcome': 'passed' if j < 7 else 'failed',
                'start_time': start_time + timedelta(seconds=j),
                'duration': 1.0,
                'error_message': 'Error' if j >= 7 else '',
                'error_type': 'AssertionError' if j >= 7 else '',
                'has_warning': j == 5,
                'rerun_count': 1 if j >= 7 else 0
            }
            add_test_result(db_path, session_id, test_result)
